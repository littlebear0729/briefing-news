{#-
  Shared print geometry: A4, fixed page boxes, exactly two pages.

  Both templates render the same two `.page` sections and the same content-block
  markup (see _macros.j2), so the printed newspaper is identical whether it was
  produced from the responsive mobile source or the print-first desktop source.

  `.page { overflow: hidden }` is what makes "exactly two pages" unconditional —
  and therefore what makes silent clipping possible. export.assert_pdf() is the
  compensating control (page count + footer text + size).

  How to use it, from a template's <style> element:

      set print_geometry_always = true    (desktop: the A4 geometry is always on)
      set print_geometry_always = false   (mobile:  the geometry applies in print only)
      include "_print.j2"

  Note for editors: do not write Jinja comment markers inside this comment — a
  nested end marker closes the comment early and the "example" code becomes live
  template code.
-#}
{% macro page_geometry() %}/* ---------- page boxes ---------- */
@page { size: A4; margin: 0 }

html, body {
  margin: 0;
  padding: 0;
  background: var(--paper);
  color: var(--ink);
}

body {
  font-family: var(--nm-font-serif);
  font-size: var(--print-body-size);
  line-height: var(--print-body-leading);
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
  font-kerning: normal;
}

p { margin: 0; }
a { color: inherit; text-decoration: none; border-bottom: var(--rule-hair) solid var(--rule-strong); }
ul, ol { margin: 0; padding: 0; list-style: none; }
figure { margin: 0; }

.page {
  position: relative;
  box-sizing: border-box;
  width: var(--page-width);
  height: var(--page-height);
  margin: 0 auto;
  padding: var(--page-pad-block) var(--page-pad-inline)
           calc(var(--page-pad-block) + var(--page-footer-space));
  overflow: hidden;
  background: var(--paper);
  color: var(--ink);
  border: 0;
  border-radius: 0;
  box-shadow: none;
  display: flex;
  flex-direction: column;
  break-inside: avoid;
  break-after: page;
  page-break-after: always;
}

.page:last-of-type {
  break-after: auto;
  page-break-after: auto;
}

/* ---------- masthead (front page) ---------- */
.masthead {
  text-align: center;
  border-bottom: var(--rule-heavy) solid var(--ink);
  padding-bottom: 1.4mm;
  margin-bottom: var(--front-gap);
}

.masthead-ornament {
  color: var(--ink-subtle);
  margin: 0 auto 0.8mm;
  max-width: 120mm;
}

.masthead-ornament svg { display: block; width: 100%; height: 3.2mm; }

.masthead-title {
  font-family: var(--nm-font-serif);
  font-size: var(--masthead-size);
  font-weight: var(--nm-weight-bold);
  line-height: 0.98;
  letter-spacing: -0.015em;
  text-transform: uppercase;
  margin: 0;
}

.masthead-meta,
.masthead-window {
  font-family: var(--nm-font-sans);
  font-size: var(--print-meta-size);
  letter-spacing: var(--nm-tracking-wide);
  text-transform: uppercase;
  color: var(--ink-muted);
}

.masthead-meta { margin-top: 1.3mm; }
.masthead-window {
  margin-top: 0.6mm;
  color: var(--ink-subtle);
  letter-spacing: 0.03em;
  text-transform: none;
}

.masthead-sep { color: var(--rule-strong); padding: 0 1.2mm; }

/* ---------- running head on page two ---------- */
.inside-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 4mm;
  border-bottom: var(--rule-heavy) solid var(--ink);
  padding-bottom: 1mm;
  margin-bottom: var(--front-gap);
  font-family: var(--nm-font-sans);
  font-size: var(--print-meta-size);
  letter-spacing: var(--nm-tracking-wide);
  text-transform: uppercase;
}

.inside-head-title { font-weight: var(--nm-weight-bold); letter-spacing: 0.04em; }
.inside-head-note { color: var(--ink-subtle); }

/* ---------- page bodies ---------- */
.page-body { min-height: 0; }
.page-body--front { display: flex; flex-direction: column; gap: var(--front-gap); }

.front-band { display: grid; gap: var(--column-gap); align-items: start; }
.front-band--top { grid-template-columns: 1.95fr 1fr; }
.front-band--bottom { grid-template-columns: 1fr 1fr 1.05fr; }

.front-rail {
  border-left: var(--rule-hair) solid var(--rule);
  padding-left: 4mm;
}

/* Two explicit column stacks — deliberately NOT CSS multicol. Inside a fixed-height
   page box a multicol container fragments into additional columns (which in paged
   media means additional sheets), or clips, and `scrollHeight` reports none of it,
   so the loss is invisible to every measurement except the text extraction in
   export.assert_pdf(). See the note at the top of _pages.j2. */
.page-body--inside {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 var(--column-gap);
  align-content: start;
}

.inside-column {
  display: flex;
  flex-direction: column;
  gap: var(--front-gap);
  min-width: 0;
}

.inside-column--right {
  border-left: var(--rule-hair) solid var(--rule);
  padding-left: 4mm;
}

/* ---------- stories ---------- */
.kicker {
  font-family: var(--nm-font-sans);
  font-size: var(--kicker-size);
  font-weight: var(--nm-weight-semibold);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.45mm;
}

.lead-headline {
  font-size: var(--lead-headline-size);
  font-weight: var(--nm-weight-bold);
  line-height: 1.03;
  letter-spacing: -0.012em;
  margin-bottom: 1.1mm;
}

.secondary-headline { font-size: var(--secondary-headline-size); line-height: 1.08; margin-bottom: 0.8mm; }
.section-headline  { font-size: var(--section-headline-size);  line-height: 1.1;  margin-bottom: 0.8mm; }
.culture-headline  { font-size: var(--culture-headline-size);  line-height: 1.12; margin-bottom: 0.7mm; }

.deck {
  font-size: var(--deck-size);
  font-style: italic;
  color: var(--ink-muted);
  margin-bottom: 0.55mm;
  text-wrap: pretty;
}

.dateline {
  font-family: var(--nm-font-sans);
  font-size: var(--print-meta-size);
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--ink-subtle);
  margin-bottom: 0.9mm;
}

.para {
  text-align: justify;
  hyphens: auto;
  margin-bottom: 1.05mm;
  orphans: 2;
  widows: 2;
}

/* The lead body is split across two explicit columns by _pages.j2 (para_block with
   a start/end slice), so the front page reads like a paper without any multicol. */
.lead-body {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--front-gap) var(--column-gap);
  align-items: start;
}

.lead-body .para:first-child::first-letter {
  float: left;
  font-size: 3.3em;
  line-height: 0.78;
  font-weight: var(--nm-weight-bold);
  padding: 0.04em 0.06em 0 0;
}

.sources {
  font-family: var(--nm-font-sans);
  font-size: var(--print-source-size);
  color: var(--ink-subtle);
  margin-top: 0.3mm;
  text-align: left;
}

.sources-label { letter-spacing: 0.06em; text-transform: uppercase; }

/* Attribution appended to the last paragraph of a story (see _macros.j2). */
.sources--inline {
  display: inline;
  margin-top: 0;
  white-space: normal;
}

.sources--inline .source-link { border-bottom: 0; }

.story + .story { margin-top: 1.2mm; }

.section { break-inside: avoid; }
.section + .section { margin-top: 0; }

.section-head {
  font-family: var(--nm-font-sans);
  font-size: var(--print-meta-size);
  font-weight: var(--nm-weight-bold);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink);
  border-bottom: var(--rule-thin) solid var(--ink);
  padding-bottom: 0.5mm;
  margin-bottom: 1.2mm;
  display: flex;
  justify-content: space-between;
  gap: 3mm;
}

.section-head-note {
  font-weight: var(--nm-weight-regular);
  letter-spacing: 0.04em;
  text-transform: none;
  color: var(--ink-subtle);
}

/* ---------- illustration ---------- */
.visual { text-align: center; margin-bottom: 2.6mm; }
.visual svg { display: block; width: 100%; height: auto; max-height: 42mm; color: var(--ink-subtle); }
.visual-caption {
  font-family: var(--nm-font-sans);
  font-size: 6pt;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-subtle);
  margin-top: 1mm;
  border-top: var(--rule-hair) solid var(--rule);
  padding-top: 0.8mm;
  text-align: left;
}

/* ---------- briefs ---------- */
.brief-list { display: grid; gap: 1.5mm; }
.brief { border-bottom: var(--rule-hair) solid var(--rule); padding-bottom: 1.3mm; }
.brief:last-child { border-bottom: 0; padding-bottom: 0; }

.brief-label {
  display: block;
  font-family: var(--nm-font-sans);
  font-size: var(--print-meta-size);
  font-weight: var(--nm-weight-semibold);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.4mm;
}

.brief-text { font-size: var(--brief-size); line-height: 1.24; text-align: left; }

/* ---------- markets ---------- */
.market-list { display: grid; gap: 0; }

.market-row {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 0.3mm 2mm;
  padding: 0.6mm 0;
  border-bottom: var(--rule-hair) solid var(--rule);
}

.market-label {
  font-family: var(--nm-font-sans);
  font-size: 7.2pt;
  font-weight: var(--nm-weight-semibold);
  letter-spacing: 0.01em;
}

.market-note {
  grid-column: 1 / -1;
  font-size: 6.5pt;
  color: var(--ink-muted);
  line-height: 1.2;
  text-align: left;
}

.market-dir {
  display: inline-block;
  width: 0;
  height: 0;
  border-left: 1.05mm solid transparent;
  border-right: 1.05mm solid transparent;
}

.market-dir--up { border-bottom: 1.5mm solid var(--dir-up); }
.market-dir--down { border-top: 1.5mm solid var(--dir-down); }
.market-dir--flat {
  width: 2.4mm;
  border-left: 0;
  border-right: 0;
  border-bottom: 0.55mm solid var(--dir-flat);
}

.markets-note {
  font-size: 6.9pt;
  color: var(--ink-muted);
  margin-top: 1.2mm;
  font-style: italic;
  text-align: left;
}

/* ---------- key numbers ---------- */
.key-numbers {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.2mm 3mm;
  margin-top: 2mm;
  border-top: var(--rule-thin) solid var(--ink);
  padding-top: 1.4mm;
}

.key-number-value {
  font-family: var(--nm-font-serif);
  font-size: 11.5pt;
  font-weight: var(--nm-weight-bold);
  line-height: 1.05;
}

.key-number-label {
  font-family: var(--nm-font-sans);
  font-size: 5.9pt;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--ink-muted);
  line-height: 1.18;
}

/* ---------- bullets ---------- */
.bullet-list { display: grid; gap: 1mm; }
.bullet { position: relative; padding-left: 3.2mm; font-size: 7.8pt; line-height: 1.28; }
.bullet::before {
  content: "";
  position: absolute;
  left: 0;
  top: 1.15mm;
  width: 1.3mm;
  height: 1.3mm;
  background: var(--ink);
}

/* ---------- footer (the assertion anchor) ---------- */
.page-footer {
  position: absolute;
  left: var(--page-pad-inline);
  right: var(--page-pad-inline);
  bottom: calc(var(--page-pad-block) - 2.5mm);
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 3mm;
  border-top: var(--rule-hair) solid var(--rule);
  padding-top: 1mm;
  font-family: var(--nm-font-sans);
  font-size: 6.1pt;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-subtle);
}

.footer-text { font-weight: var(--nm-weight-semibold); letter-spacing: 0.12em; }

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  clip-path: inset(50%);
  white-space: nowrap;
}

/* ---------- focus ---------- */
a:focus-visible,
button:focus-visible,
[tabindex]:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  box-shadow: var(--focus-ring);
  border-radius: var(--nm-radius-sm);
}
{% endmacro %}
{% if print_geometry_always %}{{ page_geometry() }}{% else %}@media print {
{{ page_geometry() }}
}{% endif %}

/* Screen-only furniture must never reach paper. This lives outside the geometry
   wrapper on purpose: the desktop artefact activates that geometry on screen too
   (so a browser preview is the PDF), which would otherwise hide the skip link in
   both media — and a skip link left in normal flow prints as its own page. */
@media print {
  .skip-link,
  .screen-nav,
  .screen-footer { display: none; }
}
