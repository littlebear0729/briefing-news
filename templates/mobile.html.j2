<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="description" content="{{ meta.title }} — {{ meta.sources_cited }} cited sources, {{ meta.page_count }} pages.">
<title>{{ meta.title }}</title>
<style>
{% include "_tokens.j2" %}

/* ==========================================================================
   Screen layout — mobile first. Breakpoints are fixed at 640 / 1024 (invariant 7):
   below 640 a single column, 640-1023 two columns, 1024+ the full broadsheet grid.

   Every rule in this block is scoped to `screen`: the printed artefact must come
   from the shared print geometry alone. A phone-first rule that leaked into print
   would matter more than it sounds — a 210mm page still satisfies `min-width:
   640px`, so the two artefacts would print differently from the same JSON.
   ========================================================================== */
@media screen {

*, *::before, *::after { box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; }

body {
  margin: 0;
  background: var(--nm-color-bg-subtle);
  color: var(--ink);
  font-family: var(--nm-font-serif);
  font-size: var(--nm-text-base);
  line-height: var(--nm-leading-normal);
  padding: 0 0 var(--nm-space-6);
}

p { margin: 0; }
ul, ol { margin: 0; padding: 0; list-style: none; }
figure { margin: 0; }
a { color: var(--ink); text-decoration: none; border-bottom: var(--rule-thin) solid var(--rule-strong); }
a:hover { color: var(--accent); border-bottom-color: var(--accent); }

a:focus-visible,
button:focus-visible,
[tabindex]:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  box-shadow: var(--focus-ring);
  border-radius: var(--nm-radius-sm);
}

.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  z-index: 20;
  background: var(--paper);
  color: var(--ink);
  padding: var(--nm-space-2) var(--nm-space-3);
  border: var(--rule-thin) solid var(--accent);
  border-radius: var(--nm-radius-sm);
  font-family: var(--nm-font-sans);
  font-size: var(--nm-text-sm);
}
.skip-link:focus { left: var(--nm-space-4); top: var(--nm-space-4); }

/* --- reading nav (screen only) ------------------------------------------- */
.screen-nav {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: var(--nm-space-2) var(--nm-space-3);
  padding: var(--nm-space-2) var(--nm-space-4);
  background: var(--paper);
  border-bottom: var(--rule-thin) solid var(--rule);
  font-family: var(--nm-font-sans);
  font-size: var(--nm-text-xs);
  letter-spacing: var(--nm-tracking-wide);
  text-transform: uppercase;
  color: var(--ink-muted);
}
.screen-nav-brand { font-weight: var(--nm-weight-bold); color: var(--ink); letter-spacing: 0.06em; }
.screen-nav-links { display: flex; flex-wrap: wrap; gap: var(--nm-space-3); margin-left: auto; }
.screen-nav a { border-bottom: 0; color: var(--ink-muted); }
.screen-nav a:hover { color: var(--accent); }

/* --- page cards ---------------------------------------------------------- */
main { display: block; }

.page {
  max-width: var(--screen-max);
  margin: 0 auto var(--nm-space-5);
  padding: var(--nm-space-5) var(--nm-space-4) var(--nm-space-4);
  background: var(--paper);
  border: var(--rule-thin) solid var(--rule);
  border-radius: var(--nm-radius-lg);
  box-shadow: var(--nm-shadow-sm);
}

.page-body--front { display: flex; flex-direction: column; gap: var(--nm-space-5); }
.front-band { display: grid; gap: var(--nm-space-5); grid-template-columns: 1fr; }
.page-body--inside { display: grid; gap: var(--nm-space-5); grid-template-columns: 1fr; }
.lead-body { display: grid; grid-template-columns: 1fr; gap: var(--nm-space-5); }
.inside-column { display: flex; flex-direction: column; gap: var(--nm-space-5); min-width: 0; }
.inside-column--right { border-left: 0; padding-left: 0; }

/* --- masthead ------------------------------------------------------------ */
.masthead {
  text-align: center;
  border-bottom: var(--rule-heavy) solid var(--ink);
  padding-bottom: var(--nm-space-3);
  margin-bottom: var(--nm-space-5);
}
.masthead-ornament { color: var(--ink-subtle); margin: 0 auto var(--nm-space-1); max-width: 30rem; }
.masthead-ornament svg { display: block; width: 100%; height: 3.2mm; }
.masthead-title {
  font-family: var(--nm-font-serif);
  font-size: clamp(1.55rem, 8vw, 2.4rem);
  font-weight: var(--nm-weight-bold);
  line-height: 1;
  letter-spacing: -0.015em;
  text-transform: uppercase;
  margin: 0;
}
.masthead-meta {
  margin-top: var(--nm-space-2);
  font-family: var(--nm-font-sans);
  font-size: var(--nm-text-xs);
  letter-spacing: var(--nm-tracking-wide);
  text-transform: uppercase;
  color: var(--ink-muted);
}
.masthead-window { margin-top: var(--nm-space-1); font-family: var(--nm-font-sans); font-size: var(--nm-text-2xs); color: var(--ink-subtle); }
.masthead-sep { color: var(--rule-strong); padding: 0 var(--nm-space-1); }

.inside-head {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: baseline;
  gap: var(--nm-space-2);
  border-bottom: var(--rule-thin) solid var(--ink);
  padding-bottom: var(--nm-space-2);
  margin-bottom: var(--nm-space-4);
  font-family: var(--nm-font-sans);
  font-size: var(--nm-text-xs);
  letter-spacing: var(--nm-tracking-wide);
  text-transform: uppercase;
}
.inside-head-title { font-weight: var(--nm-weight-bold); }
.inside-head-note { color: var(--ink-subtle); }

/* --- stories ------------------------------------------------------------- */
.kicker {
  font-family: var(--nm-font-sans);
  font-size: var(--nm-text-2xs);
  font-weight: var(--nm-weight-semibold);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: var(--nm-space-1);
}
.lead-headline { font-size: clamp(1.5rem, 6.4vw, 2.15rem); font-weight: var(--nm-weight-bold); line-height: 1.07; letter-spacing: -0.012em; margin-bottom: var(--nm-space-2); }
.secondary-headline { font-size: var(--nm-text-lg); line-height: 1.2; margin-bottom: var(--nm-space-1); }
.section-headline { font-size: var(--nm-text-base); line-height: 1.24; margin-bottom: var(--nm-space-1); }
.culture-headline { font-size: var(--nm-text-sm); line-height: 1.28; margin-bottom: var(--nm-space-1); }
.deck { font-size: var(--nm-text-base); font-style: italic; color: var(--ink-muted); margin-bottom: var(--nm-space-2); }
.dateline { font-family: var(--nm-font-sans); font-size: var(--nm-text-2xs); letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-subtle); margin-bottom: var(--nm-space-2); }
.para { text-align: left; margin-bottom: var(--nm-space-3); }
.story + .story { margin-top: var(--nm-space-5); }
.lead-body .para:first-child::first-letter { font-size: 1em; float: none; padding: 0; font-weight: inherit; }

.sources { font-family: var(--nm-font-sans); font-size: var(--nm-text-2xs); color: var(--ink-subtle); margin-top: var(--nm-space-2); }
.sources-label { text-transform: uppercase; letter-spacing: 0.06em; }
.sources .source-link { border-bottom-style: dotted; }

.section-head {
  display: flex;
  justify-content: space-between;
  gap: var(--nm-space-3);
  font-family: var(--nm-font-sans);
  font-size: var(--nm-text-xs);
  font-weight: var(--nm-weight-bold);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  border-bottom: var(--rule-thin) solid var(--ink);
  padding-bottom: var(--nm-space-1);
  margin-bottom: var(--nm-space-3);
}
.section-head-note { font-weight: var(--nm-weight-regular); letter-spacing: 0.04em; text-transform: none; color: var(--ink-subtle); }
.section--briefs { border-top: var(--rule-hair) solid var(--rule); padding-top: var(--nm-space-3); }

/* --- illustration -------------------------------------------------------- */
.visual { text-align: center; margin-bottom: var(--nm-space-4); }
.visual svg { display: block; width: auto; max-width: 100%; max-height: 44vh; margin: 0 auto; color: var(--ink-subtle); }
.visual-caption {
  margin-top: var(--nm-space-2);
  padding-top: var(--nm-space-1);
  border-top: var(--rule-hair) solid var(--rule);
  font-family: var(--nm-font-sans);
  font-size: var(--nm-text-2xs);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-subtle);
  text-align: left;
}

/* --- briefs -------------------------------------------------------------- */
.brief-list { display: grid; gap: var(--nm-space-3); }
.brief { border-bottom: var(--rule-hair) solid var(--rule); padding-bottom: var(--nm-space-3); }
.brief:last-child { border-bottom: 0; padding-bottom: 0; }
.brief-label { display: block; font-family: var(--nm-font-sans); font-size: var(--nm-text-2xs); font-weight: var(--nm-weight-semibold); letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: var(--nm-space-1); }
.brief-text { font-size: var(--nm-text-sm); }

/* --- markets ------------------------------------------------------------- */
.market-row {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: var(--nm-space-1) var(--nm-space-3);
  padding: var(--nm-space-2) 0;
  border-bottom: var(--rule-hair) solid var(--rule);
}
.market-label { font-family: var(--nm-font-sans); font-size: var(--nm-text-sm); font-weight: var(--nm-weight-semibold); }
.market-note { grid-column: 1 / -1; font-size: var(--nm-text-xs); color: var(--ink-muted); }
.market-dir { display: inline-block; width: 0; height: 0; border-left: 1.05mm solid transparent; border-right: 1.05mm solid transparent; }
.market-dir--up { border-bottom: 1.5mm solid var(--dir-up); }
.market-dir--down { border-top: 1.5mm solid var(--dir-down); }
.market-dir--flat { width: 2.4mm; border-left: 0; border-right: 0; border-bottom: 0.55mm solid var(--dir-flat); }
.markets-note { font-size: var(--nm-text-sm); font-style: italic; color: var(--ink-muted); margin-top: var(--nm-space-3); }

/* --- key numbers --------------------------------------------------------- */
.key-numbers { display: grid; grid-template-columns: 1fr 1fr; gap: var(--nm-space-3); margin-top: var(--nm-space-4); border-top: var(--rule-thin) solid var(--ink); padding-top: var(--nm-space-3); }
.key-number-value { font-family: var(--nm-font-serif); font-size: var(--nm-text-xl); font-weight: var(--nm-weight-bold); line-height: 1.05; }
.key-number-label { font-family: var(--nm-font-sans); font-size: var(--nm-text-2xs); letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-muted); }

/* --- bullets ------------------------------------------------------------- */
.bullet-list { display: grid; gap: var(--nm-space-2); }
.bullet { position: relative; padding-left: var(--nm-space-4); font-size: var(--nm-text-sm); }
.bullet::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 1.3mm; height: 1.3mm; background: var(--ink); }

/* --- footers ------------------------------------------------------------- */
.page-footer {
  display: flex;
  justify-content: space-between;
  gap: var(--nm-space-3);
  margin-top: var(--nm-space-5);
  padding-top: var(--nm-space-2);
  border-top: var(--rule-hair) solid var(--rule);
  font-family: var(--nm-font-sans);
  font-size: var(--nm-text-2xs);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-subtle);
}
.footer-text { font-weight: var(--nm-weight-semibold); }

.screen-footer {
  max-width: var(--screen-max);
  margin: 0 auto;
  padding: var(--nm-space-4);
  font-family: var(--nm-font-sans);
  font-size: var(--nm-text-xs);
  color: var(--ink-subtle);
}
.screen-footer p + p { margin-top: var(--nm-space-2); }

.visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }

} /* end @media screen */

/* ==========================================================================
   >= 640px — two columns for everything that pairs naturally
   ========================================================================== */
@media screen and (min-width: 640px) {
  .page { padding: var(--nm-space-5) var(--nm-space-5) var(--nm-space-4); }
  .front-band--top { grid-template-columns: 1.7fr 1fr; align-items: start; }
  .front-band--bottom { grid-template-columns: 1fr 1fr; align-items: start; }
  .front-band--bottom .section--markets { grid-column: 1 / -1; }
  .lead-body { grid-template-columns: 1fr 1fr; gap: var(--nm-space-4); align-items: start; }
  .page-body--inside { grid-template-columns: 1fr 1fr; gap: var(--nm-space-5) var(--nm-space-5); }
  .brief-list { grid-template-columns: 1fr 1fr; }
  .brief { border-bottom: var(--rule-hair) solid var(--rule); }
  .key-numbers { grid-template-columns: repeat(4, 1fr); }
  .bullet-list { grid-template-columns: 1fr 1fr; }
}

/* ==========================================================================
   >= 1024px — broadsheet grid on the desktop
   ========================================================================== */
@media screen and (min-width: 1024px) {
  body { font-size: var(--nm-text-lg); }
  .page { max-width: var(--screen-max-wide); padding: var(--nm-space-6) var(--nm-space-6) var(--nm-space-5); }
  .screen-footer { max-width: var(--screen-max-wide); }
  .front-band--top { grid-template-columns: 2fr 1fr; }
  .front-band--bottom { grid-template-columns: 1fr 1fr 1.05fr; }
  .front-band--bottom .section--markets { grid-column: auto; }
  .front-rail { border-left: var(--rule-thin) solid var(--rule); padding-left: var(--nm-space-5); }
  .page-body--inside { grid-template-columns: 1fr 1fr; gap: var(--nm-space-6) var(--nm-space-6); }
  .inside-column--right { border-left: var(--rule-thin) solid var(--rule); padding-left: var(--nm-space-6); }
  .lead-headline { font-size: clamp(2.1rem, 3vw, 2.9rem); }
  .secondary-headline { font-size: var(--nm-text-xl); }
  .section-headline { font-size: var(--nm-text-lg); }
  .culture-headline { font-size: var(--nm-text-base); }
  .brief-list { grid-template-columns: 1fr; }
  .bullet-list { grid-template-columns: 1fr; }
  .lead-body { gap: var(--nm-space-6); }
  .lead-body .para:first-child::first-letter { float: left; font-size: 3.2em; line-height: 0.78; font-weight: var(--nm-weight-bold); padding: 0.04em 0.06em 0 0; }
}

{% set print_geometry_always = false %}{% include "_print.j2" %}
</style>
</head>
<body>
<a class="skip-link" href="#page-1">Skip to the front page</a>

<nav class="screen-nav" aria-label="Edition sections">
<span class="screen-nav-brand">The Global Brief</span>
<span class="screen-nav-issue">{{ meta.date_short }} · {{ meta.edition_label }} · No. {{ meta.edition_number }}</span>
<span class="screen-nav-links">
<a href="#lead">Lead</a>
<a href="#briefs">Briefs</a>
<a href="#markets">Markets</a>
<a href="#technology">Technology</a>
<a href="#finance">Finance</a>
<a href="#sport">Sport</a>
<a href="#culture">Culture</a>
</span>
</nav>

{% include "_pages.j2" %}

<footer class="screen-footer">
<p>{{ meta.note }} · {{ meta.stats.stories }} stories · {{ meta.stats.words }} words · generated {{ meta.generated_at }}</p>
<p>Every link above points to a whitelisted source domain. This edition was assembled by code from {{ meta.candidates }} candidates; the model chose and wrote, it never chose a URL or a layout.</p>
</footer>
</body>
</html>
