{#-
  Design tokens. TWO :root blocks, in this order, always at the top of the <style>
  element (DESIGN.md invariant 7):

    1. Neutral Modern design system — the vendored structural block: spacing, type
       scale, radii, focus ring. Values here are not edited in place.
    2. The Global Brief project palette — newspaper: newsprint paper, ink, rules,
       masthead red, texture tints.

  Consequence of the split: outside the two :root blocks there must be no colour
  *literal* (hex/rgb/hsl). Every rule below reads a token.
-#}
:root {
  /* --- Neutral Modern: colour (kept complete; the project block overrides what it uses) --- */
  --nm-color-bg: #ffffff;
  --nm-color-bg-subtle: #fafafa;
  --nm-color-surface: #f4f4f5;
  --nm-color-border: #e4e4e7;
  --nm-color-border-strong: #d4d4d8;
  --nm-color-text: #18181b;
  --nm-color-text-muted: #52525b;
  --nm-color-text-subtle: #71717a;
  --nm-color-accent: #1d4ed8;
  --nm-color-accent-subtle: #eef2ff;
  --nm-color-on-accent: #ffffff;
  --nm-color-positive: #15803d;
  --nm-color-negative: #b91c1c;
  --nm-color-neutral: #57534e;

  /* --- Neutral Modern: type --- */
  --nm-font-sans: "Segoe UI", "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  --nm-font-serif: Georgia, "Iowan Old Style", "Times New Roman", "Noto Serif", serif;
  --nm-font-mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  --nm-text-2xs: 0.625rem;
  --nm-text-xs: 0.75rem;
  --nm-text-sm: 0.875rem;
  --nm-text-base: 1rem;
  --nm-text-lg: 1.125rem;
  --nm-text-xl: 1.25rem;
  --nm-text-2xl: 1.5rem;
  --nm-text-3xl: 1.875rem;
  --nm-leading-tight: 1.15;
  --nm-leading-snug: 1.35;
  --nm-leading-normal: 1.55;
  --nm-tracking-wide: 0.08em;
  --nm-weight-regular: 400;
  --nm-weight-medium: 500;
  --nm-weight-semibold: 600;
  --nm-weight-bold: 700;

  /* --- Neutral Modern: space --- */
  --nm-space-1: 0.25rem;
  --nm-space-2: 0.5rem;
  --nm-space-3: 0.75rem;
  --nm-space-4: 1rem;
  --nm-space-5: 1.5rem;
  --nm-space-6: 2rem;
  --nm-space-8: 3rem;
  --nm-space-10: 4rem;
  --nm-space-12: 6rem;

  /* --- Neutral Modern: shape, elevation, focus --- */
  --nm-radius-sm: 2px;
  --nm-radius-md: 4px;
  --nm-radius-lg: 8px;
  --nm-shadow-sm: 0 1px 2px rgba(24, 24, 27, 0.06);
  --nm-shadow-md: 0 2px 8px rgba(24, 24, 27, 0.08);
  --nm-focus-ring: 0 0 0 2px #ffffff, 0 0 0 4px #1d4ed8;

  /* --- Neutral Modern: breakpoints (fixed contract: 640 / 1024) --- */
  --nm-breakpoint-sm: 640px;
  --nm-breakpoint-lg: 1024px;
}

:root {
  /* --- The Global Brief: newsprint palette --- */
  --desk: #dcd5c5;              /* the surface the paper lies on */
  --paper: #f5f0e3;             /* newsprint body */
  --paper-raised: #fbf8ef;      /* boxes and rules' breathing room */
  --paper-sunken: #ebe4d2;      /* digests, tables */
  --ink: #17140f;
  --ink-muted: #494337;
  --ink-subtle: #6c6455;
  --rule: #bdb29c;
  --rule-faint: #d5cbb6;
  --rule-strong: #17140f;
  --accent: #8a1c1c;            /* masthead and kicker red */
  --accent-quiet: #a4433c;
  --dir-up: #1f5c3a;
  --dir-down: #8a1c1c;
  --dir-flat: #6c6455;
  --grain: rgba(23, 20, 15, 0.035);
  --grain-fine: rgba(23, 20, 15, 0.02);
  --shadow-paper: 0 1px 1px rgba(23, 20, 15, 0.10), 0 12px 32px rgba(23, 20, 15, 0.14);
  --focus-ring: 0 0 0 2px var(--paper), 0 0 0 4px var(--accent);

  /* --- type: a newspaper, so serif for the reading, sans for the labels --- */
  --font-body: Georgia, "Iowan Old Style", "Times New Roman", "Noto Serif", "Songti SC", serif;
  --font-display: "Playfair Display", Georgia, "Iowan Old Style", "Times New Roman", serif;
  --font-label: "Segoe UI", "Helvetica Neue", Arial, "Noto Sans", sans-serif;

  --text-body: 1.02rem;
  --text-body-lg: 1.08rem;
  --leading-body: 1.62;
  --masthead-size: clamp(2.5rem, 11vw, 4.6rem);
  --lead-headline: clamp(1.9rem, 6.4vw, 3.1rem);
  --secondary-headline: clamp(1.25rem, 3vw, 1.6rem);
  --section-headline: clamp(1.15rem, 2.4vw, 1.4rem);
  --culture-headline: 1.06rem;
  --kicker-size: 0.66rem;
  --label-size: 0.66rem;
  --sheet-gap: clamp(1.5rem, 3vw, 2.5rem);
  --measure: 34rem;

  /* --- structure --- */
  --hair: 1px;
  --rule-thin: 1px;
  --rule-heavy: 3px;
  --paper-max: 74rem;
}
