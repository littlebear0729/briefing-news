{#-
  Content-block macros. Layout lives in _layout.j2 and in newspaper.html.j2's
  responsive rules; these emit semantics only.

  Reminder (invariant 8): `trim_blocks`/`lstrip_blocks` are on, and Jinja resolves
  `x.markets.items` as the dict method — always write `e.markets['items']`.
-#}

{% macro kicker_line(item, section_title) -%}
<p class="kicker">{{ item.kicker if item.kicker else section_title }}</p>
{%- endmacro %}

{% macro headline_block(item, headline_class, section_title) -%}
{{ kicker_line(item, section_title) }}
<h3 class="{{ headline_class }}">{{ item.headline }}</h3>
{% if item.deck %}<p class="deck">{{ item.deck }}</p>{% endif %}
{% if item.dateline %}<p class="dateline">{{ item.dateline }}</p>{% endif %}
{%- endmacro %}

{#- A newspaper attribution — "— Reuters, AP" — rather than a line of its own. -#}
{% macro source_inline(item) -%}
{% if item.sources %}<span class="sources">— {% for source in item.sources %}<a class="source-link" href="{{ source.url }}" rel="noopener noreferrer">{{ source.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}
{%- endmacro %}

{% macro source_line(item) -%}
{% if item.sources %}
<p class="sources"><span class="sources-label">{{ 'Sources' if item.sources|length > 1 else 'Source' }}:</span>
{% for source in item.sources %}<a class="source-link" href="{{ source.url }}" rel="noopener noreferrer">{{ source.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
</p>
{% endif %}
{%- endmacro %}

{% macro para_block(item, paras_class, start=0, end=None, with_sources=false) -%}
<div class="{{ paras_class }}">
{% for para in item.paras[start:end] %}
<p class="para">{{ para }}{% if with_sources and loop.last %} {{ source_inline(item) }}{% endif %}</p>
{% endfor %}
</div>
{%- endmacro %}

{% macro story_block(item, section_title, headline_class, paras_class, story_class='story') -%}
<article class="{{ story_class }}">
{{ headline_block(item, headline_class, section_title) }}
{{ para_block(item, paras_class, 0, None, true) }}
</article>
{%- endmacro %}

{% macro briefs_panel(briefs, heading) -%}
<section class="section section--briefs" id="briefs" aria-label="{{ heading }}">
<h2 class="section-head"><span>{{ heading }}</span></h2>
<ul class="brief-list">
{% for brief in briefs %}
<li class="brief">
<span class="brief-label">{{ brief.label }}</span>
<span class="brief-text">{{ brief.text }}</span>
</li>
{% endfor %}
</ul>
</section>
{%- endmacro %}

{% macro markets_panel(markets, heading) -%}
<section class="section section--markets" id="markets" aria-label="{{ heading }}">
<h2 class="section-head"><span>{{ heading }}</span></h2>
<ul class="market-list">
{% for market in markets['items'] %}
<li class="market-row">
<span class="market-label">{{ market.label }}</span>
<span class="market-dir market-dir--{{ market.dir }}" aria-hidden="true"></span>
<span class="visually-hidden">trending {{ market.dir }}</span>
<span class="market-note">{{ market.note }}</span>
</li>
{% endfor %}
</ul>
{% if markets.note %}<p class="markets-note">{{ markets.note }}</p>{% endif %}
</section>
{%- endmacro %}

{% macro key_numbers_panel(numbers, heading) -%}
<div class="key-numbers" role="group" aria-label="{{ heading }}">
{% for number in numbers %}
<div class="key-number">
<div class="key-number-value">{{ number.value }}</div>
<div class="key-number-label">{{ number.label }}</div>
</div>
{% endfor %}
</div>
{%- endmacro %}

{% macro bullets_panel(bullets) -%}
<ul class="bullet-list">
{% for bullet in bullets %}
<li class="bullet">{{ bullet }}</li>
{% endfor %}
</ul>
{%- endmacro %}

{% macro sheet_footer(footer_text, label) -%}
<footer class="sheet-footer">
<span class="footer-text">{{ footer_text }}</span>
<span class="sheet-page">{{ label }}</span>
</footer>
{%- endmacro %}
